package components

import "github.com/cloud-resume/api/internal/data"

templ Metrics(metrics []data.Metric) {
	<section class="mb-10">
		<div class="flex items-center justify-between mb-4">
			<h2 class="text-sm uppercase tracking-wider font-mono font-semibold text-slate-400">
				// Engineering Impact & Production Metrics
			</h2>
			<span class="text-xs font-mono text-cyan-400">Telemetry: Real-time SLA</span>
		</div>
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
			for _, m := range metrics {
				<div class="card p-5 bg-slate-900/50 hover:border-cyan-500/40 transition-all duration-200">
					<div class="flex items-center justify-between mb-3">
						<span class="text-xs font-mono text-slate-400 font-medium">{ m.Label }</span>
						<span class="p-1.5 rounded-md bg-cyan-950/60 text-cyan-400 border border-cyan-800/40">
							if m.Icon == "shield-check" {
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
								</svg>
							} else if m.Icon == "zap" {
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
								</svg>
							} else if m.Icon == "cpu" {
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M3 9h2m-2 6h2m14-6h2m-2 6h2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"></path>
								</svg>
							} else {
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 17h8m0 0V9m0 8l-8-8-4 4-6-6"></path>
								</svg>
							}
						</span>
					</div>
					<div class="text-3xl font-extrabold text-white tracking-tight font-mono mb-1">
						{ m.Value }
					</div>
					<p class="text-xs text-slate-400 leading-normal">
						{ m.Description }
					</p>
				</div>
			}
		</div>
	</section>
}
